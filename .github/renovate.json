{
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned mise version installed by the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG MISE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s"
      ],
      "depNameTemplate": "jdx/mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
