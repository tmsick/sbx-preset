{
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned mise version installed by the template",
      "managerFilePatterns": ["/^template\\/Dockerfile$/"],
      "matchStrings": ["ARG MISE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "jdx/mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Bump the pinned fish version installed by the template",
      "managerFilePatterns": ["/^template\\/Dockerfile$/"],
      "matchStrings": ["ARG FISH_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "fish-shell/fish-shell",
      "packageNameTemplate": "fish-shell/fish-shell",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the pinned Neovim version installed by the template",
      "managerFilePatterns": ["/^template\\/Dockerfile$/"],
      "matchStrings": ["ARG NVIM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "neovim/neovim",
      "packageNameTemplate": "neovim/neovim",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
