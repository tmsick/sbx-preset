#!/usr/bin/env python3
"""Create a sandbox from tmsick/sbx-preset's published template and kits.

    curl -fsSL https://raw.githubusercontent.com/tmsick/sbx-preset/main/tools/sbx-init \\
      -o ~/bin/sbx-init && chmod +x ~/bin/sbx-init                     # once
    sbx settings set kit.allowedSources '["docker.io/","ghcr.io/tmsick/"]'  # once
    sbx-init .                                                         # from then on

    sbx-init PATH   create a sandbox for PATH

Everything comes from ghcr.io/tmsick/sbx-preset -- no clone of that repository
needed. `kit/claude`, `kit/git` and `kit/net` attach to every sandbox;
`kit-opt/<service>` attaches only when asked for (`--with <service>`).

Unrecognized flags are handed to `sbx create` as-is (`sbx-init . --profile
strict`); it rejects the ones it doesn't know, so typos still surface.

Standard library only, 3.9 syntax, so it runs under whichever python3 the
target project's mise config happens to put on PATH.
"""

import argparse
import json
import shlex
import subprocess
import sys
from pathlib import Path
from typing import NoReturn

REGISTRY = "ghcr.io/tmsick/sbx-preset"
KIT_TAG = "latest"

# Mirrors .github/workflows/kits.yml's publish matrix in the source repo --
# keep the two in sync by hand if a kit is added or removed there.
DEFAULT_KITS = ["kit/claude", "kit/git", "kit/net"]
OPT_KIT_SERVICES = ["asana", "atlassian", "figma"]

# The Dockerfile's BASE_VARIANT (its final-<variant> stages) that goes with
# each agent. Anything else needs an explicit --template.
VARIANTS = {"claude": "claude-code", "shell": "shell"}


def fail(msg, *hints) -> NoReturn:
    print(f"sbx-init: {msg}", file=sys.stderr)
    for hint in hints:
        print(f"  {hint}", file=sys.stderr)
    sys.exit(1)


def run(cmd, dry_run=False):
    print(f"+ {shlex.join(cmd)}", file=sys.stderr)
    if dry_run:
        return
    subprocess.run(cmd, check=True)


def sbx_json(*args):
    out = subprocess.run(
        ["sbx", *args, "--json"], check=True, capture_output=True, text=True
    ).stdout
    return json.loads(out)


def with_names(values):
    """Flatten repeated and comma-separated --with values."""
    return [name for value in values for name in value.split(",") if name]


def opt_kits(names):
    """Resolve --with names against OPT_KIT_SERVICES."""
    for name in names:
        if name not in OPT_KIT_SERVICES:
            fail(
                f"no kit-opt/{name}",
                f"available: {', '.join(OPT_KIT_SERVICES)}",
            )
    return [f"kit-opt/{name}" for name in names]


def sandbox_for(path):
    """Name of the sandbox holding PATH, or None.

    Matches a workspace itself or any directory under it, longest first, so it
    works from a subdirectory of the project too.
    """
    best = ""
    name = None
    for sandbox in sbx_json("ls")["sandboxes"]:
        for workspace in sandbox.get("workspaces", []):
            # Read-only extra workspaces carry a :ro suffix on the CLI; don't
            # rely on it being stripped here.
            for suffix in (":ro", ":rw"):
                workspace = workspace.removesuffix(suffix)
            candidate = Path(workspace)
            if (path == candidate or candidate in path.parents) and len(
                workspace
            ) > len(best):
                best, name = workspace, sandbox["name"]
    return name


def cmd_create(args, extra):
    workspace = Path(args.path).resolve()
    if not workspace.is_dir():
        fail(f"{workspace} is not a directory")

    existing = sandbox_for(workspace)
    if existing:
        print(f"sandbox {existing!r} already covers {workspace}")
        print(f"attach with: sbx run --name {existing}")
        return

    template = args.template
    if not template:
        variant = VARIANTS.get(args.agent)
        if not variant:
            fail(
                f"no sbx-preset variant for agent {args.agent!r}",
                "pass --template, or add the variant upstream",
            )
        template = f"{REGISTRY}:{variant}"

    cmd = ["sbx", "create", "--template", template]
    for kit in DEFAULT_KITS + opt_kits(with_names(args.with_)):
        cmd += ["--kit", f"{REGISTRY}/{kit}:{KIT_TAG}"]
    if args.name:
        cmd += ["--name", args.name]
    # Anything left over goes last, where it reads as an argument to `sbx create`
    # itself: extra flags (cobra takes them after the positionals) and extra
    # workspaces (`sbx-init . ../docs:ro`) both land correctly.
    cmd += [args.agent, str(workspace), *extra]
    run(cmd, args.dry_run)


def main():
    parser = argparse.ArgumentParser(
        prog="sbx-init",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Required rather than defaulting to ".": a sandbox created against the wrong
    # tree does not fail, it succeeds quietly, and `sbx create` reads an omitted
    # path as "provision an empty workspace" rather than "here".
    parser.add_argument("path", metavar="PATH")
    parser.add_argument("--agent", default="claude", help="default: claude")
    parser.add_argument("--template", help="override the sbx-preset variant")
    parser.add_argument("--name", help="default: sbx's own <agent>-<workdir>")
    parser.add_argument(
        "--with",
        dest="with_",
        action="append",
        default=[],
        metavar="SERVICE",
        help="also attach kit-opt/SERVICE (repeatable, or comma-separated)",
    )
    parser.add_argument("--dry-run", action="store_true", help="print commands only")
    args, extra = parser.parse_known_args(sys.argv[1:])
    return cmd_create(args, extra)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as err:
        sys.exit(err.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
